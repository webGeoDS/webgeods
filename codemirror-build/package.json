{
  "name": "webgeods-codemirror-build",
  "private": true,
  "description": "Reproducible build for shared/codemirror-bundle.js — not part of the published site itself, see build.sh.",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --outfile=../shared/codemirror-bundle.js"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright": "^1.62.1",
    "codemirror": "6.0.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/lang-python": "6.1.6",
    "codemirror-lang-r": "0.1.1",
    "@codemirror/theme-one-dark": "6.1.2",
    "@codemirror/autocomplete": "6.20.3"
  }
}
